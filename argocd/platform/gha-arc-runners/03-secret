---------------------------------------------------------------------
1. Secret
---------------------------------------------------------------------
    tgb-shopverse-gitops(Administration: read and write)
    ----------------------------------------------------
kubectl create secret generic shopverse-github-token \
  -n arc-runners \
  --from-literal=github_token='YOUR_PAT'

Note: You can achieve this using ESO also.

---------------------------------------------------------------------
2. Argocd CLI
---------------------------------------------------------------------

VERSION=$(curl -L -s https://raw.githubusercontent.com/argoproj/argo-cd/stable/VERSION)
curl -sSL -o argocd-linux-amd64 https://github.com/argoproj/argo-cd/releases/download/v$VERSION/argocd-linux-amd64
sudo install -m 555 argocd-linux-amd64 /usr/local/bin/argocd
rm argocd-linux-amd64

---------------------------------------------------------------------
3. Pull helm chart
---------------------------------------------------------------------
helm pull \
  oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set \
  --version 0.15.0 \
  --untar


---------------------------------------------------------------------
4. Annotate Service Account
---------------------------------------------------------------------
kubectl annotate serviceaccount \
  shopverse-dev-runners-gha-rs-no-permission \
  -n arc-runners \
  "eks.amazonaws.com/role-arn=${RUNNER_ROLE_ARN}" \
  --overwrite


