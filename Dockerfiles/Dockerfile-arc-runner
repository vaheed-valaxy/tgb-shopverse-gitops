FROM ghcr.io/actions/actions-runner:latest

USER root

ARG KUBECTL_VERSION=v1.33.0
ARG ARGOCD_VERSION=v3.2.0

# Install curl, certificates, and unzip
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      gh \
      curl \
      ca-certificates \
      unzip && \
    rm -rf /var/lib/apt/lists/*

# Install AWS CLI v2
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "${ARCH}" in \
      amd64) AWS_ARCH="x86_64" ;; \
      arm64) AWS_ARCH="aarch64" ;; \
      *) echo "Unsupported architecture: ${ARCH}"; exit 1 ;; \
    esac; \
    curl -fsSL \
      "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip" \
      -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install --install-dir /usr/local/aws-cli --bin-dir /usr/local/bin; \
    rm -rf /tmp/aws /tmp/awscliv2.zip

# Install kubectl
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "${ARCH}" in \
      amd64) K8S_ARCH="amd64" ;; \
      arm64) K8S_ARCH="arm64" ;; \
      *) echo "Unsupported architecture: ${ARCH}"; exit 1 ;; \
    esac; \
    curl -fsSL \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${K8S_ARCH}/kubectl" \
      -o /usr/local/bin/kubectl; \
    chmod +x /usr/local/bin/kubectl

# Install Argo CD CLI
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "${ARCH}" in \
      amd64) ARGO_ARCH="amd64" ;; \
      arm64) ARGO_ARCH="arm64" ;; \
      *) echo "Unsupported architecture: ${ARCH}"; exit 1 ;; \
    esac; \
    curl -fsSL \
      "https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-${ARGO_ARCH}" \
      -o /usr/local/bin/argocd; \
    chmod +x /usr/local/bin/argocd

# Verify installations during image build
RUN aws --version && \
    kubectl version --client && \
    argocd version --client && \
    curl --version

USER runner

-------------------------------------------------------------------------

docker build \
  --platform linux/amd64 \
  --build-arg KUBECTL_VERSION=v1.33.0 \
  --build-arg ARGOCD_VERSION=v3.2.0 \
  -t "${RUNNER_IMAGE}" .


--------------------------------------------------------------------------

template:
  spec:
    containers:
      - name: runner
        image: 254405569649.dkr.ecr.us-east-1.amazonaws.com/shopverse-dev-arc-runner:v1
        imagePullPolicy: Always

